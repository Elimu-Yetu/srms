# Elimu Yetu SRMS — Apache security rules

# Disable directory listings
Options -Indexes

# ── Deny direct access to sensitive directories ──────────────────────────────
# The app/, storage/, and scripts/ directories must never be served directly.
<IfModule mod_authz_core.c>
    # Apache 2.4+
    <DirectoryMatch "^.*(\.git|app|storage|scripts)(/|$)">
        Require all denied
    </DirectoryMatch>
</IfModule>
<IfModule !mod_authz_core.c>
    # Apache 2.2
    <DirectoryMatch "^.*(\.git|app|storage|scripts)(/|$)">
        Order deny,allow
        Deny from all
    </DirectoryMatch>
</IfModule>

# ── Protect sensitive files ───────────────────────────────────────────────────
<FilesMatch "(composer\.json|composer\.lock|\.env|config\.php|db\.php|\.gitignore|README\.md|INSTALL\.md|LICENSE)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# ── Prevent access to backup files ───────────────────────────────────────────
<FilesMatch "\.(sql|sqlite|bak|log|lock)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# ── Remove server signature ───────────────────────────────────────────────────
ServerSignature Off

# ── Disable HTTP TRACE method ─────────────────────────────────────────────────
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_METHOD} ^TRACE
    RewriteRule .* - [F]
</IfModule>

# Elimu Yetu SRMS — nginx server block (only if you use nginx instead of Apache)
server {
    listen 80;
    server_name srms.local;
    root /var/www/srms;
    index index.php;

    location / { try_files $uri $uri/ /index.php?$query_string; }

    # Never serve application code, the database or uploads directly.
    location ~ ^/(app|storage)/ { deny all; return 404; }
    location ~ \.(sqlite|sqlite3|sql|log)$ { deny all; return 404; }

    location ~ \.php$ {
        include fastcgi_params;
        fastcgi_pass unix:/run/php/php8.3-fpm.sock;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
    }

    client_max_body_size 8M;
}
